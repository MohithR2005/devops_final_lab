# CI has already compiled and tested this exact JAR on a GitHub-hosted runner.
# Build context is dist/ so no source code or credentials enter this image.
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app app
COPY --chown=app:app tasktracker-0.0.1-SNAPSHOT.jar /app/app.jar
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
